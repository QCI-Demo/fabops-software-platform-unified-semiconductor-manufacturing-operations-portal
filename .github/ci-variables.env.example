# Copy values into GitHub Actions repository Variables / Environments.
# Do NOT commit real credentials. HELM_REPO_URL is non-secret (in-cluster DNS).

HELM_REPO_URL=http://chartmuseum.dev.svc.cluster.local:8080
HELM_REPO_NAME=fabops-dev
CHARTMUSEUM_NAMESPACE=dev
CHART_PUBLISHER_SA=chart-publisher

# Optional: external ingress URL once Ingress/ALB is enabled
# HELM_REPO_EXTERNAL_URL=https://charts.dev.fabops.example.com
