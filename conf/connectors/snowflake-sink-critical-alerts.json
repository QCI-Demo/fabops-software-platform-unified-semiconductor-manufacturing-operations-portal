{
  "name": "snowflake-sink-critical-alerts",
  "config": {
    "connector.class": "com.snowflake.kafka.connector.SnowflakeSinkConnector",
    "tasks.max": "2",
    "topics": "fabops.equipment.critical-alert",
    "snowflake.url.name": "${env:SNOWFLAKE_URL}",
    "snowflake.user.name": "${env:SNOWFLAKE_USER}",
    "snowflake.private.key": "${env:SNOWFLAKE_PRIVATE_KEY}",
    "snowflake.private.key.passphrase": "${env:SNOWFLAKE_PRIVATE_KEY_PASSPHRASE}",
    "snowflake.database.name": "FABOPS_DW",
    "snowflake.schema.name": "STAGING",
    "snowflake.topic2table.map": "fabops.equipment.critical-alert:CRITICAL_ALERT_EVENTS",
    "snowflake.metadata.createtime.column.name": "_KAFKA_INGEST_TS",
    "snowflake.metadata.offset.column.name": "_KAFKA_OFFSET",
    "snowflake.metadata.partition.column.name": "_KAFKA_PARTITION",
    "snowflake.metadata.topic.column.name": "_KAFKA_TOPIC",
    "snowflake.metadata.all": "true",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "${env:SCHEMA_REGISTRY_URL}",
    "value.converter.enhanced.avro.schema.support": "true",
    "value.converter.connect.meta.data": "false",
    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "fabops.connect.dlq.critical-alerts",
    "errors.deadletterqueue.topic.replication.factor": "3",
    "errors.deadletterqueue.context.headers.enable": "true",
    "errors.log.enable": "true",
    "errors.log.include.messages": "true",
    "buffer.count.records": "5000",
    "buffer.flush.time": "60",
    "buffer.size.bytes": "2500000",
    "snowflake.ingestion.method": "SNOWPIPE_STREAMING",
    "snowflake.enable.schematization": "true",
    "behavior.on.null.values": "IGNORE",
    "transforms": "ExtractTimestamp,InsertEventTime,FlattenPayload",
    "transforms.ExtractTimestamp.type": "org.apache.kafka.connect.transforms.InsertField$Value",
    "transforms.ExtractTimestamp.timestamp.field": "_event_time",
    "transforms.InsertEventTime.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.InsertEventTime.target.type": "Timestamp",
    "transforms.InsertEventTime.field": "timestamp",
    "transforms.InsertEventTime.format": "unix",
    "transforms.FlattenPayload.type": "org.apache.kafka.connect.transforms.Flatten$Value",
    "transforms.FlattenPayload.delimiter": "_"
  }
}
